+                    changeset->brightness = device->observedBrightness();
+                }
             }
             if (device != output->brightnessDevice()) {
-                changeset->currentHardwareBrightness = device->observedBrightness();
+                if (!edrPinned) {
+                    changeset->currentHardwareBrightness = device->observedBrightness();
+                }
             }
         }
     }
