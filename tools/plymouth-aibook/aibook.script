# AIBook splash: the KDE ksplash rabbit (org.aibook.splash) reproduced as a
# pre-composited frame sequence.  Plymouth's script plugin cannot scale images
# and its opacity/Math path proved unreliable, so gen-frames.py renders the
# exact ksplash maths (four quadrant sprites faded by sin phase) into 24 frames
# and this script only advances the frame index.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

FRAME_COUNT = 4;
TICKS_PER_FRAME = 35;  # script plugin refreshes at 50 Hz -> 0.7 s per corner

for (i = 0; i < FRAME_COUNT; i++) {
  if (i < 10) {
    frame_image[i] = Image("frame-0" + i + ".png");
  } else {
    frame_image[i] = Image("frame-" + i + ".png");
  }
}

frame_sprite = Sprite(frame_image[0]);
frame_sprite.SetX((Window.GetWidth() - frame_image[0].GetWidth()) / 2);
frame_sprite.SetY((Window.GetHeight() - frame_image[0].GetHeight()) / 2);

aibook_tick = 0;

fun refresh_callback () {
  aibook_tick = aibook_tick + 1;
  frame_sprite.SetImage(frame_image[Math.Int(aibook_tick / TICKS_PER_FRAME) % FRAME_COUNT]);
}

Plymouth.SetRefreshFunction(refresh_callback);
